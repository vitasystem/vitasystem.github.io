<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0c0813"><title>BLACK RABBITS: UNCENSORED — VITA SYSTEM</title>
<meta name="robots" content="noindex,nofollow">
<link rel="icon" href="assets/img/vita-planet-icon-v2-48.png">
<style>
:root{--bg:#090711;--panel:#140f1c;--frame:#553066;--pink:#f46af5;--purple:#a962e5;--cream:#fcf3ff;--muted:#b69ec4;--line:#593c6b;--lime:#a5efcf}*{box-sizing:border-box}html,body{min-height:100%;margin:0;background:#090711;color:var(--cream);font-family:'Segoe UI',Arial,sans-serif}body{background:radial-gradient(ellipse at 50% -30%,#792b8c4d,transparent 60%),#090711;overflow-x:hidden}button{cursor:pointer;color:inherit;font:inherit}button:focus-visible{outline:2px solid #ffd3ff;outline-offset:3px}button:disabled{opacity:.42;cursor:not-allowed}.app{max-width:1500px;min-height:100vh;margin:0 auto}.header{display:flex;align-items:center;gap:13px;padding:12px 20px;min-height:82px;border-bottom:1px solid #5c31745e;background:#100b17e8}.sig{height:54px;width:54px;object-fit:contain;filter:drop-shadow(0 0 12px #d64aff65)}.brand small{display:block;font-size:9px;letter-spacing:.25em;color:#c5a1d5}.brand strong{display:block;font-size:clamp(13px,1.6vw,22px);letter-spacing:.055em;font-weight:950;line-height:1.32}.brand strong em{color:#efadfa;font-style:normal}.brand .motto{font-size:10px;letter-spacing:.18em;color:#a684b4}.header-spacer{flex:1}.header-actions{display:flex;gap:7px;align-items:center}.tiny-btn{background:linear-gradient(180deg,#23182d,#16101e);border:1px solid #72508b;border-radius:8px;padding:9px 11px;min-height:37px;font-size:11px;font-weight:700;letter-spacing:.04em}.tiny-btn:hover{border-color:#d78fff;background:#382044}.ico-btn{width:39px;height:39px;border:1px solid #785289;background:#25172b;border-radius:9px;display:grid;place-items:center;padding:5px}.ico-btn img{height:27px;width:27px;object-fit:contain}.ico-btn:hover{border-color:#d8a1ed}.shell{display:grid;grid-template-columns:230px minmax(0,1fr) 218px;min-height:calc(100vh - 128px)}.panel{background:#120e19;padding:20px 17px;display:flex;flex-direction:column;gap:12px}.panel.left{border-right:1px solid #57346d77}.panel.right{border-left:1px solid #57346d77}.kicker{font-size:10px;color:#cb9bda;letter-spacing:.18em;font-weight:850}.stage-name{font-size:23px;margin:3px 0 0;letter-spacing:.03em}.stage-sub{font-size:11px;color:#baa1c4;line-height:1.5}.level-list{display:grid;gap:9px;margin:12px 0}.level-card{display:flex;align-items:center;gap:10px;border:1px solid #4e315a;background:linear-gradient(130deg,#261831,#170f1f);padding:11px;border-radius:9px;opacity:.68}.level-card.current{border-color:#d18bf3;background:#392044;opacity:1;box-shadow:inset 0 0 18px #ca5bdf27}.level-card.done{opacity:.93;border-color:#755189}.level-card .num{width:28px;height:28px;flex:none;border:1px solid #765184;border-radius:50%;display:grid;place-items:center;color:#dda7f4;font-size:11px;font-weight:900}.level-card strong{font-size:11px;letter-spacing:.1em;display:block}.level-card span{font-size:10px;color:#af8cbb}.note{border:1px solid #4d325d;border-radius:10px;background:#1b1323;padding:13px;font-size:11px;line-height:1.75;color:#c9b7d0}.note b{color:#f5d8ff}.character-show{border:1px solid #4f3064;background:radial-gradient(ellipse at 50% 60%,#7a26743b,transparent 70%),#0d0a14;border-radius:13px;height:210px;display:flex;justify-content:center;align-items:center;overflow:hidden;position:relative}.character-show img{height:185px;max-width:96%;object-fit:contain;filter:drop-shadow(0 10px 13px #000d)}.character-show label{position:absolute;bottom:8px;right:10px;background:#140c1abc;color:#cba2e0;font-size:9px;padding:4px 5px;border-radius:4px;letter-spacing:.08em}.center{padding:15px 18px 16px;min-width:0;background:linear-gradient(160deg,#130e1b,#0b0911)}.stagebar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 10px}.stagebar .stageleft{font-weight:850;letter-spacing:.14em;color:#d09de1;font-size:11px}.statrow{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}.stat{font-size:11px;border:1px solid #5c3b70;border-radius:6px;background:#201629;padding:6px 9px;color:#c2a2d2}.stat strong{color:#fff}.arena-wrap{position:relative;width:100%;aspect-ratio:1000/560;border:1px solid #a360b1;border-radius:15px;overflow:hidden;background:#08060d;box-shadow:0 12px 65px #000b,0 0 0 4px #7c3a8b19}.arena-wrap canvas{display:block;width:100%;height:100%;touch-action:none;cursor:crosshair}.arena-wrap.flight canvas{cursor:move}.canvas-message{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:#130a1cc9;border:1px solid #924cb35e;border-radius:7px;padding:7px 12px;color:#f3d0ff;font-size:11px;letter-spacing:.09em;pointer-events:none;white-space:nowrap;max-width:96%;overflow:hidden;text-overflow:ellipsis}.canvas-message:empty{display:none}.overlay{position:absolute;inset:0;background:linear-gradient(105deg,#0a0712f7,#100916dc 62%,#140b19c3);z-index:10;display:flex;justify-content:center;align-items:center;padding:25px;overflow:auto}.overlay[hidden]{display:none}.overlay-panel{width:min(90%,610px);text-align:center;position:relative;z-index:2}.cover-art{width:min(98%,530px);height:clamp(160px,26vw,290px);object-fit:contain;filter:drop-shadow(0 0 30px #b943dd47);display:block;margin:0 auto 7px}.overlay h1{font-size:clamp(28px,4vw,55px);letter-spacing:.015em;margin:10px 0;line-height:1.1}.overlay h1 em{font:italic .88em Georgia,serif;color:#e8a5f2}.overlay .sub{font-size:12px;line-height:1.7;color:#ddc4e5;margin:11px 0 20px}.action-main{border:1px solid #fadfff;border-radius:9px;padding:13px 24px;background:linear-gradient(100deg,#e9c5f8,#bd73dd);color:#260c35;font-weight:900;letter-spacing:.12em;box-shadow:0 9px 28px #ab53c747}.action-main:hover{filter:brightness(1.1)}.overlay-label{max-height:105px;max-width:90%;object-fit:contain;filter:drop-shadow(0 0 14px #b850da67)}.overlay-art{max-height:170px;max-width:76%;object-fit:contain;filter:drop-shadow(0 0 22px #bb4acf70)}.overlay .small{display:block;margin-top:13px;font-size:10px;color:#ab8bba;letter-spacing:.06em}.controls{min-height:63px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px;justify-content:space-between}.hint{font-size:11px;color:#c3a9d1;line-height:1.6;max-width:610px}.hint b{color:white}.rolebar{display:flex;gap:7px;flex-wrap:wrap}.rolebar[hidden]{display:none}.role-btn{border:1px solid #775087;border-radius:9px;background:#24162c;padding:8px 10px;display:flex;gap:7px;align-items:center;min-width:91px}.role-btn.sel{background:#5c2c6f;border-color:#e6a7f2}.role-btn img{width:32px;height:36px;object-fit:contain}.role-btn small{font-size:10px;font-weight:800;white-space:nowrap}.fire-actions{display:flex;gap:8px;align-items:center}.fire-actions[hidden]{display:none}.shoot{background:linear-gradient(135deg,#ce69df,#9e3fc5);border:1px solid #f5baff;border-radius:9px;padding:10px 18px;font-weight:900;letter-spacing:.06em;min-height:45px;user-select:none;touch-action:none}.special{border:1px solid #9d57ac;border-radius:9px;padding:10px 12px;background:#25192d;font-weight:800;min-height:45px}.special.ready{border-color:#ffc2fe;box-shadow:0 0 16px #d752dc6e;background:#5a2069;animation:pulse 1s infinite alternate}.panel-line{height:1px;background:#513464;margin:4px 0}.metric{padding:12px 0;border-bottom:1px solid #493252}.metric label{display:block;font-size:10px;letter-spacing:.14em;color:#aa8ab8;margin-bottom:7px}.metric strong{font-size:23px;color:#f9e9ff}.meter{height:6px;border-radius:5px;background:#291c34;margin-top:10px;overflow:hidden}.meter div{height:100%;width:0;background:linear-gradient(90deg,#8533ae,#ef8cf3);transition:width .25s}.subtitle{font:700 12px Georgia,serif;color:#dcb4e7}.right .logo{width:100%;height:114px;object-fit:contain;filter:drop-shadow(0 0 16px #bc45cc54)}.footer{padding:11px 20px;border-top:1px solid #55366b65;color:#8f75a1;font-size:10px;letter-spacing:.09em;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.toast{position:absolute;top:65px;left:50%;transform:translateX(-50%);background:#321b41e9;border:1px solid #a976d2;color:#fff;border-radius:8px;padding:10px 17px;font-weight:850;letter-spacing:.08em;font-size:14px;z-index:7;pointer-events:none;opacity:0;transition:opacity .2s;text-align:center}.toast.show{opacity:1}@keyframes pulse{from{filter:brightness(1)}to{filter:brightness(1.45)}}@media(max-width:1180px){.shell{grid-template-columns:170px minmax(0,1fr) 170px}.panel{padding:14px 11px}.right .logo{height:95px}.center{padding:12px}.character-show{height:160px}.character-show img{height:135px}}@media(max-width:900px){.shell{grid-template-columns:minmax(0,1fr)}.panel.left,.panel.right{display:none}.center{padding:9px}.header{padding:10px 12px;min-height:67px}.sig{height:43px;width:43px}.brand strong{font-size:15px}.brand .motto{font-size:8px}.statrow{gap:4px}.stat{font-size:10px;padding:5px 6px}.stagebar{margin:0 0 7px}.stagebar .stageleft{font-size:10px}.controls{padding:0 5px}.footer{padding:12px}.arena-wrap{border-radius:9px}}@media(max-width:500px){.brand .motto{display:none}.brand small{font-size:8px}.brand strong{font-size:12px}.header{gap:5px;padding:7px}.sig{height:35px;width:35px}.header-actions{gap:3px}.tiny-btn{padding:7px;font-size:10px;min-height:33px}.ico-btn{width:32px;height:33px;padding:4px}.ico-btn img{width:22px;height:22px}.stagebar .stageleft{display:none}.statrow{justify-content:center;width:100%}.arena-wrap{aspect-ratio:1000/760}.arena-wrap canvas{height:100%;width:100%}.overlay{padding:6px 7px}.overlay-panel{width:100%}.overlay h1{font-size:22px;margin:4px 0}.overlay .sub{font-size:10px;margin:4px 0 9px;line-height:1.4}.overlay .small{display:none}.overlay-label{max-height:62px}.cover-art{height:116px;margin-bottom:0}.action-main{padding:9px 14px;font-size:12px}.role-btn{min-width:unset;padding:5px 7px}.role-btn img{width:26px;height:29px}.role-btn small{font-size:9px}.controls{gap:7px}.hint{font-size:10px}.canvas-message{font-size:9px;bottom:5px}.footer{font-size:8px}.fire-actions{width:100%;justify-content:space-evenly}.shoot,.special{flex:1}}

/* v0.2.1 — viewport / start-screen readability only; game mechanics unchanged.
   The inner 1000×560 canvas keeps its original proportions and pointer mapping. */
@media (min-width:501px){
  .arena-wrap{aspect-ratio:1000/650;background:radial-gradient(ellipse at 50% 45%,#24102d 0%,#100918 67%,#08060d 100%)}
  .arena-wrap canvas{position:absolute;top:50%;left:0;width:100%;height:auto;aspect-ratio:1000/560;transform:translateY(-50%)}
}
@media (min-width:901px) and (max-width:1500px){
  .cover-art{height:clamp(160px,19vw,250px)}
  .overlay{padding:15px 20px}
  .overlay h1{font-size:clamp(30px,3.6vw,48px)}
}
@media (min-width:501px) and (max-width:900px){
  .cover-art{height:clamp(95px,17vw,165px)}
  .overlay{padding:10px 12px}
  .overlay h1{font-size:clamp(24px,3.8vw,36px);margin:5px 0}
  .overlay .sub{font-size:10px;margin:6px 0 10px;line-height:1.4}
  .overlay .small{display:none}
  .action-main{padding:9px 15px}
}
/* v0.3: compact in-arena controls + cinematic VITA finisher; original viewport remains unchanged */
.arena-l2-commands{position:absolute;top:14px;left:18px;z-index:5;width:min(390px,calc(100% - 36px));padding:10px 11px;border-radius:12px;border:1px solid #a466bf8f;background:linear-gradient(125deg,#1f102ce9,#0c081bdd);box-shadow:0 8px 30px #000b,0 0 22px #a84cdb2c;pointer-events:auto}
.arena-l2-commands[hidden],.vita-finisher-btn[hidden]{display:none!important}
.arena-l2-task{font-size:12px;line-height:1.45;color:#f8d8ff;font-weight:900;letter-spacing:.07em;text-shadow:0 1px 8px #000;min-height:18px}
.arena-l2-picker{display:flex;gap:7px;margin-top:7px}
.arena-l2-pick{display:flex;align-items:center;justify-content:center;gap:5px;flex:1;min-width:0;border-radius:9px;border:1px solid #78468d;background:#2d183a;color:#f9e9fc;padding:6px 5px;font-size:10px;font-weight:900;white-space:nowrap}
.arena-l2-pick img{width:27px;height:32px;object-fit:contain}
.arena-l2-pick:hover,.arena-l2-pick.sel{background:#7b358b;border-color:#ffc4fb;box-shadow:0 0 18px #e57ef75b}
.vita-finisher-btn{position:absolute;z-index:7;left:50%;bottom:8%;transform:translateX(-50%);min-width:220px;max-width:85%;border:2px solid #ffd7fe;border-radius:12px;padding:13px 25px;background:linear-gradient(95deg,#e7b3fb,#a94ad3);color:#260d35;box-shadow:0 0 28px #ba49df95;font-size:18px;font-weight:1000;letter-spacing:.09em;animation:pulse 0.75s infinite alternate}
.vita-finisher-btn:hover{filter:brightness(1.18)}
@media(max-width:500px){.arena-l2-commands{left:6px;top:6px;padding:5px 7px;width:calc(100% - 12px);border-radius:7px}.arena-l2-task{font-size:9px;min-height:12px;letter-spacing:0}.arena-l2-picker{gap:4px;margin-top:3px}.arena-l2-pick{font-size:8px;padding:3px 2px;border-radius:5px}.arena-l2-pick img{display:none}.vita-finisher-btn{min-width:150px;font-size:12px;padding:8px 12px;bottom:11%}}
/* v0.3.1: single-tap Rabbit Attack, team-vs-enemy colors */
#rolebar{display:none!important}
.arena-l2-commands{pointer-events:none;width:min(445px,calc(100% - 36px))}
.arena-l2-picker{display:none!important}
.arena-l2-task{color:#fff2ff;font-size:13px;letter-spacing:.025em}
@media(max-width:500px){.arena-l2-commands{width:calc(100% - 12px)}.arena-l2-task{font-size:9px}}
#sideHelp,#rightHelp,#helpText,#arenaMessage,#arenaL2Commands{display:none!important}
/* v0.5: compact effects volume; no change to game layout */
.sound-volume{display:flex;align-items:center;gap:4px;padding:4px 7px;border:1px solid #73518b;border-radius:9px;color:#d99aef;font-size:12px;background:#21142b;min-height:38px}
.sound-volume input{width:74px;accent-color:#cf70e8;cursor:pointer}
@media(max-width:600px){.sound-volume{display:none}}
</style>

<style id="br-gate-style">
html:not(.br-access-open) .app{display:none!important}
html.br-access-open #br-access-gate{display:none!important}
#br-access-gate{min-height:100vh;min-height:100svh;padding:36px 20px;background:radial-gradient(ellipse at 50% 35%,#24112f,#08060c 65%);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#f4e5fa;font-family:Segoe UI,Arial,sans-serif}
#br-access-gate .br-gate-label{letter-spacing:.36em;color:#c888e8;font-size:12px}
#br-access-gate h1{font-size:clamp(28px,6vw,56px);line-height:1.08;margin:24px 0 12px}
#br-access-gate p{color:#c9b2d0;max-width:470px;line-height:1.6}
#br-access-gate a{color:white;border:1px solid #9862b0;background:#3d1a50;text-decoration:none;padding:15px 24px;border-radius:12px;margin-top:18px;display:inline-block;font-weight:700}
.br-back-home{white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;padding:9px 13px;border:1px solid #73518b;background:#21142b;border-radius:9px;color:#f5d8ff;font-size:12px;font-weight:800;min-height:38px}
@media(max-width:650px){.br-back-home{font-size:0;padding:9px}.br-back-home::before{content:'↩';font-size:18px}}
</style>
<script id="br-gate-check">
(function(){
  let unlocked=false;
  try {
    const c=JSON.parse(localStorage.getItem('vita-black-rabbits-collection-v1')||'{}');
    unlocked=Array.isArray(c.found)&&new Set(c.found.filter(n=>Number.isInteger(n)&&n>=0&&n<5)).size===5;
  }catch(e){}
  if(unlocked)document.documentElement.classList.add('br-access-open');
})();
</script>
</head><body>
<div id="br-access-gate" role="main"><span class="br-gate-label">VITA SYSTEM · BLACK RABBITS</span><h1>Двері ще зачинені.</h1><p>Повернися на головну сторінку, знайди п’ятьох чорних кроликів і заповни їхні силуети біля дверей.</p><a href="index.html?lang=uk#black-rabbit-portal" id="br-gate-return">← ДО ДВЕРЕЙ</a></div>

<div class="app">
<header class="header"><img id="headerTrident" class="sig" alt="Готичний тризуб"><div class="brand"><small>VITA SYSTEM PRESENTS</small><strong>BLACK RABBITS: <em>UNCENSORED</em></strong><span class="motto">NO BORDERS. NO LIMITS.</span></div><div class="header-spacer"></div><div class="header-actions"><a class="br-back-home" id="br-site-return" href="index.html?lang=uk#black-rabbit-portal" title="Повернутися до дверей">← ДО ДВЕРЕЙ</a><button class="tiny-btn" id="langBtn" title="Змінити мову">УКР / EN</button><button class="ico-btn" id="soundBtn" title="Увімкнути / вимкнути звук"><img id="soundIcon" alt="звук"></button><label class="sound-volume" title="Гучність ігрових звуків"><span>♪</span><input id="soundVolume" type="range" min="0" max="100" step="5" value="60" aria-label="Гучність звуків"></label><button class="ico-btn" id="pauseBtn" title="Пауза"><img id="pauseIcon" alt="пауза"></button><button class="ico-btn" id="restartBtn" title="Спочатку"><img id="restartIcon" alt="заново"></button></div></header>
<main class="shell"><aside class="panel left"><div class="kicker">VITA SYSTEM / GAME 001</div><div class="stage-name" id="sideStage">ТРИ РІВНІ</div><div class="stage-sub" id="sideSub">Кролики та ВІТА йдуть у наступ</div><div class="level-list" id="levelList"></div><div class="panel-line"></div><div class="kicker" id="squadTitle">ЗАГІН / 224</div><div class="character-show"><img id="sideRabbit" alt="Чорний кролик із тризубом"><label id="heroBadge">BLACK RABBIT</label></div><div class="note" id="sideHelp">Наводь приціл</div></aside>
<section class="center"><div class="stagebar"><div class="stageleft" id="stageKicker">MISSION 01 / ПРИЦІЛ</div><div class="statrow"><div class="stat">♥ <strong id="hpText">5</strong></div><div class="stat"><span id="labelScore">РАХУНОК</span> <strong id="scoreText">0</strong></div><div class="stat"><span id="labelLoot">ТРОФЕЇ</span> <strong id="lootText">0</strong></div><div class="stat"><span id="labelCount">ЦІЛІ</span> <strong id="countText">0/7</strong></div></div></div>
<div class="arena-wrap" id="arenaWrap"><canvas id="scene" width="1000" height="560" role="img" aria-label="Ігрове поле BLACK RABBITS"></canvas><div class="toast" id="toast"></div>
<div class="arena-l2-commands" id="arenaL2Commands" hidden>
  <div class="arena-l2-task" id="arenaL2Task">АТАКА</div>
  <div class="arena-l2-picker">
    <button class="arena-l2-pick" data-role="hammer" type="button"><img id="quickHammer" alt=""><span>1 · МОЛОТ</span></button>
    <button class="arena-l2-pick" data-role="blower" type="button"><img id="quickBlow" alt=""><span>2 · ТРУБА</span></button>
    <button class="arena-l2-pick" data-role="scout" type="button"><img id="quickScout" alt=""><span>3 · ШВИДКИЙ</span></button>
  </div>
</div>
<button id="vitaHitBtn" type="button" class="vita-finisher-btn" hidden>⚡ УДАР ВІТИ</button><div id="arenaMessage" class="canvas-message"></div><div id="overlay" class="overlay"><div class="overlay-panel"><img class="cover-art" id="overlayArt" alt="BLACK RABBITS"><img class="overlay-label" id="overlayLabel" alt="" hidden><h1 id="overlayTitle">BLACK RABBITS <em>UNCENSORED</em></h1><div class="sub" id="overlayText">Кролики та ВІТА йдуть у наступ</div><button class="action-main" id="overlayBtn">ПОЧАТИ ГРУ</button><span class="small" id="overlayFoot">NO BORDERS. NO LIMITS.</span></div></div></div>
<div class="controls"><div class="hint" id="helpText">Наводь приціл</div><div class="rolebar" id="rolebar" hidden><button class="role-btn sel" data-role="hammer"><img id="roleHammer" alt=""><small id="roleHammerText">1 · МОЛОТ</small></button><button class="role-btn" data-role="blower"><img id="roleBlow" alt=""><small id="roleBlowText">2 · ТРУБА</small></button><button class="role-btn" data-role="scout"><img id="roleScout" alt=""><small id="roleScoutText">3 · ШВИДКИЙ</small></button></div><div class="fire-actions" id="fireActions" hidden><button class="shoot" id="fireBtn">✦ ВОГОНЬ</button><button class="special" id="specialBtn" disabled>FW224 · СПЕЦУДАР [F]</button></div></div></section>
<aside class="panel right"><div class="kicker">FATAL WITCH / FW224</div><img class="logo" id="rightLogo" alt="VITA FW224"><div class="metric"><label id="rightMainLabel">ПРОГРЕС РІВНЯ</label><strong id="rightValue">0 / 7</strong><div class="meter"><div id="progressBar"></div></div></div><div class="metric"><label id="rightScoreLabel">ЗІБРАНО ПРИПАСІВ</label><strong id="rightLoot">0</strong></div><div class="metric"><label id="rightHitsLabel">ВЛУЧАННЯ</label><strong id="rightHits">0</strong></div><div class="panel-line"></div><div class="kicker">NO BORDERS. NO LIMITS.</div><div class="note" id="rightHelp">Наводь приціл</div></aside></main>
<footer class="footer"><span>© VITA SYSTEM · BLACK RABBITS: UNCENSORED</span><span id="footText">BLACK RABBITS · FINAL PROTOTYPE v0.5</span></footer>
